# Public site URL (SEO)
NEXT_PUBLIC_SITE_URL=https://glansigbiltvatterikslundab.se

# ── Supabase (required for live bookings + admin) ──
# Project Settings → API — ALL three sites share ONE project URL + service role
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional alias (never put the service role in NEXT_PUBLIC_*)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Hard tenant isolation (server-only). Must be one of: eskilstuna | erikslund | skovde
# This app defaults to erikslund if unset. Never send site_id from the browser.
BOOKING_SITE_ID=erikslund

# ── Admin panel (/admin) ──
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=long-random-string-at-least-32-chars

# Owner notification (Web3Forms fallback – optional; FormSubmit is primary backup)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# FormSubmit is activated for glansigbilvarderikslund@gmail.com
# Endpoint id lives in src/data/site.ts → SITE.formSubmitId

# Required for customer confirmation emails (free Gmail SMTP)
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (and on Vercel)
SMTP_USER=glansigbilvarderikslund@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
BOOKING_OWNER_EMAIL=glansigbilvarderikslund@gmail.com
